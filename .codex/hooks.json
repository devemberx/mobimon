{
  "description": "Validate pull-request content and merge commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/validate_merge.py\"",
            "timeout": 30,
            "statusMessage": "Checking pull-request merge policy"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/validate_pr_command.py\"",
            "timeout": 30,
            "statusMessage": "Checking pull-request template"
          }
        ]
      }
    ]
  }
}
