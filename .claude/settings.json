{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/validate_merge.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/validate_pr_command.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
